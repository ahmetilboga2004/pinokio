# Copy this file to .env and fill in the values from your Supabase project.
# Supabase Dashboard → Project Settings → API Keys:
#   - Project URL     → VITE_SUPABASE_URL (looks like https://xxxxx.supabase.co)
#   - Publishable key → VITE_SUPABASE_PUBLISHABLE_KEY (starts with sb_publishable_)
# Use the publishable key, never a secret key. Then run: npm run build
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
